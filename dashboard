    <!-- ===== MAIN CONTENT ===== -->
    <main class="ml-64 min-h-screen">
        <!-- Header -->
        <header class="sticky top-0 z-10 bg-slate-900/60 backdrop-blur-xl border-b border-slate-700/30 px-8 py-4">
            <div class="flex items-center justify-between">
