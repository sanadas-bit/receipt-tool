                    <h2 class="text-xl font-bold text-white">ダッシュボード</h2>
                    <p class="text-xs text-slate-400 mt-0.5" id="headerDate"></p>
                </div>
                <button id="btnOpenSheet" onclick="openSheet()"
                    class="bg-slate-800 hover:bg-slate-700 border border-slate-600/50 text-sm font-medium text-slate-300 rounded-lg px-4 py-2 transition-all flex items-center gap-2">
