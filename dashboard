                        <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wide">今月の合計金額</span>
                    </div>
                    <p class="text-3xl font-extrabold text-white" id="statAmount"><span
                            class="shimmer inline-block w-24 h-8 rounded"></span></p>
                    <p class="text-xs text-slate-400 mt-1">円（税込）</p>
                </div>
                <!-- Card 3: 関与先数 -->
                <div
                    class="stat-card fade-up bg-gradient-to-br from-slate-800/80 to-slate-800/40 border border-slate-700/40 rounded-2xl p-5 card-glow">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 bg-purple-500/15 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wide">登録関与先数</span>
                    </div>
                    <p class="text-3xl font-extrabold text-white" id="statClients"><span
                            class="shimmer inline-block w-10 h-8 rounded"></span></p>
                    <p class="text-xs text-slate-400 mt-1">社</p>
                </div>
            </div>

            <!-- ===== QUICK MENU ===== -->
            <div>
                <h3 class="text-sm font-semibold text-slate-400 mb-4 uppercase tracking-wider">クイックメニュー</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- 領収書データ化ツール -->
                    <div id="menuTool"
                        class="menu-card fade-up bg-gradient-to-br from-indigo-600/20 to-indigo-900/30 border border-indigo-500/20 rounded-2xl p-6 flex items-center gap-5 group">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-indigo-700 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-500/20 flex-shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-white">領収書データ化ツール</h4>
                            <p class="text-xs text-slate-400 mt-1">画像/PDFをアップロードしてAIで自動解析</p>
                        </div>
                        <svg class="w-5 h-5 text-slate-500 ml-auto group-hover:text-indigo-400 group-hover:translate-x-1 transition-all"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                    <!-- 関与先管理 -->
                    <div id="menuClients"
                        class="menu-card fade-up bg-gradient-to-br from-purple-600/20 to-purple-900/30 border border-purple-500/20 rounded-2xl p-6 flex items-center gap-5 group">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-700 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-500/20 flex-shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-white">関与先管理</h4>
                            <p class="text-xs text-slate-400 mt-1">関与先の追加・編集・削除と統計情報</p>
                        </div>
                        <svg class="w-5 h-5 text-slate-500 ml-auto group-hover:text-purple-400 group-hover:translate-x-1 transition-all"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                    <!-- データ検索 -->
                    <div id="menuSearch"
                        class="menu-card fade-up bg-gradient-to-br from-emerald-600/20 to-emerald-900/30 border border-emerald-500/20 rounded-2xl p-6 flex items-center gap-5 group">
                        <div
                            class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/20 flex-shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-white">データ検索</h4>
                            <p class="text-xs text-slate-400 mt-1">保存済みの全データを多角的に検索・エクスポート</p>
                        </div>
                        <svg class="w-5 h-5 text-slate-500 ml-auto group-hover:text-emerald-400 group-hover:translate-x-1 transition-all"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- ===== RECENT ACTIVITY ===== -->
            <div class="fade-up">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">直近の処理履歴</h3>
                    <div class="relative min-w-[240px]">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </span>
                        <input type="text" id="dashSearch" oninput="filterRecent()" placeholder="履歴から検索（支払先・関与先など）..."
                            class="w-full bg-slate-900 border border-slate-700/50 rounded-lg pl-9 pr-4 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-all">
                    </div>
                </div>
                <div class="bg-slate-800/50 border border-slate-700/40 rounded-2xl overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-slate-700/50">
                                    <th
                                        class="text-left px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        日付</th>
                                    <th
                                        class="text-left px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        関与先</th>
                                    <th
                                        class="text-left px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        支払先</th>
                                    <th
                                        class="text-right px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        金額</th>
                                    <th
                                        class="text-left px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        勘定科目</th>
                                    <th
                                        class="text-left px-5 py-3 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                                        処理日時</th>
                                </tr>
                            </thead>
                            <tbody id="recentBody">
                                <tr>
                                    <td colspan="6" class="px-5 py-8 text-center text-slate-500 text-xs">読み込み中...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        var BASE_URL = '';
        var S = { items: [] };

        document.addEventListener('DOMContentLoaded', function () {
            // 今日の日付表示
            var now = new Date();
            var months = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
            var days = ['日', '月', '火', '水', '木', '金', '土'];
            document.getElementById('headerDate').textContent =
                now.getFullYear() + '年' + months[now.getMonth()] + now.getDate() + '日（' + days[now.getDay()] + '）';

            // ベースURLを取得してナビゲーションリンクを設定
            google.script.run.withSuccessHandler(function (url) {
                BASE_URL = url;
                document.getElementById('navTool').onclick = function (e) { e.preventDefault(); window.top.location.href = url + '?page=tool'; };
                document.getElementById('navClients').onclick = function (e) { e.preventDefault(); window.top.location.href = url + '?page=clients'; };
                document.getElementById('navSearch').onclick = function (e) { e.preventDefault(); window.top.location.href = url + '?page=search'; };
                document.getElementById('menuTool').onclick = function () { window.top.location.href = url + '?page=tool'; };
                document.getElementById('menuClients').onclick = function () { window.top.location.href = url + '?page=clients'; };
                document.getElementById('menuSearch').onclick = function () { window.top.location.href = url + '?page=search'; };
            }).getAppUrl();

            // ダッシュボードデータを取得
            google.script.run.withSuccessHandler(function (data) {
                document.getElementById('statCount').textContent = data.totalThisMonth;
                document.getElementById('statAmount').textContent = '¥' + Number(data.amountThisMonth).toLocaleString();
                document.getElementById('statClients').textContent = data.clientCount;
                S.items = data.recentItems || [];
                renderRecent(S.items);
            }).withFailureHandler(function (e) {
                document.getElementById('statCount').textContent = '-';
                document.getElementById('statAmount').textContent = '-';
                document.getElementById('statClients').textContent = '-';
                document.getElementById('recentBody').innerHTML =
                    '<tr><td colspan="6" class="px-5 py-8 text-center text-rose-400 text-xs">データ取得エラー: ' + esc(e.message) + '</td></tr>';
            }).getDashboardData();
        });

        function filterRecent() {
            var kw = document.getElementById('dashSearch').value.trim().toLowerCase();
            if (!kw) { renderRecent(S.items); return; }
            var filtered = S.items.filter(function (item) {
                var txt = (item.payee + ' ' + item.clientName + ' ' + item.account + ' ' + item.memo).toLowerCase();
                return txt.indexOf(kw) !== -1;
            });
            renderRecent(filtered);
        }

        function renderRecent(items) {
            var tbody = document.getElementById('recentBody');
            if (!items || items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="px-5 py-8 text-center text-slate-500 text-xs">データがありません</td></tr>';
                return;
            }
            tbody.innerHTML = '';
            items.forEach(function (item) {
                var tr = document.createElement('tr');
                tr.className = 'border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors';
                var dateDisp = (item.date || '').replace(/-/g, '/');
                tr.innerHTML =
                    '<td class="px-5 py-3 text-slate-300 font-mono text-xs">' + esc(dateDisp) + '</td>' +
                    '<td class="px-5 py-3"><span class="bg-slate-700/60 text-slate-300 px-2 py-0.5 rounded-md text-xs font-medium">' + esc(item.clientName) + '</span></td>' +
                    '<td class="px-5 py-3 text-white font-medium">' + esc(item.payee) + '</td>' +
                    '<td class="px-5 py-3 text-right text-emerald-400 font-semibold font-mono">¥' + Number(item.amount).toLocaleString() + '</td>' +
                    '<td class="px-5 py-3 text-slate-400 text-xs">' + esc(item.account) + '</td>' +
                    '<td class="px-5 py-3 text-slate-500 text-xs">' + esc(item.createdAt) + '</td>';
                tbody.appendChild(tr);
            });
        }

        function openSheet() {
            google.script.run.withSuccessHandler(function (url) {
                if (url) window.open(url, '_blank');
                else alert('スプレッドシートが未作成です');
            }).getSheetUrl();
        }

        function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    </script>
</body>

</html>
