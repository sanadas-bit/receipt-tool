<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>領収書・請求書データ化ツール</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { sans: ['"Noto Sans JP"', '"Inter"', 'system-ui', 'sans-serif'] } } } };
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap');

        .cropper-view-box {
            outline: 3px dashed #f97316;
            outline-offset: -2px
        }

        .cropper-line {
            background-color: #f97316
        }

        .cropper-point {
            background-color: #f97316;
            width: 10px !important;
            height: 10px !important;
            border-radius: 50%
        }

        .cropper-face {
            background-color: rgba(249, 115, 22, 0.08)
        }

        .scroll-thin::-webkit-scrollbar {
            width: 4px
        }

        .scroll-thin::-webkit-scrollbar-track {
            background: transparent
        }

        .scroll-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 2px
        }

        .drop-active {
            border-color: #6366f1 !important;
            background: #eef2ff !important
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .2);
            border-color: #6366f1
        }

        @keyframes sin {
            from {
                transform: translateX(100%);
                opacity: 0
            }

            to {
                transform: translateX(0);
                opacity: 1
            }
        }

        @keyframes sout {
            from {
                transform: translateX(0);
                opacity: 1
            }

            to {
                transform: translateX(100%);
                opacity: 0
            }
        }

        .t-in {
            animation: sin .3s ease-out forwards
        }

        .t-out {
            animation: sout .3s ease-in forwards
        }

        .fi {
            transition: all .15s ease
        }

        .fi:hover {
            background: #f1f5f9
        }

        .fi.active {
            background: #eef2ff;
            border-left: 3px solid #6366f1
        }

        .tab-active {
            border-bottom: 2px solid #6366f1;
            color: #4f46e5;
            font-weight: 600
        }

        .tab-inactive {
            border-bottom: 2px solid transparent;
            color: #94a3b8
        }

        .month-header {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .05em;
            position: sticky;
            top: 0;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: space-between
        }

        .month-header .month-total {
            font-weight: 600;
            color: #6366f1;
            font-size: 10px
        }

        .pdf-page-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 8px
        }

        .pdf-page-container canvas {
            box-shadow: 0 2px 8px rgba(0, 0, 0, .1);
            border-radius: 4px
        }
    </style>
</head>

<body class="h-screen flex flex-col bg-slate-50 text-slate-800 font-sans overflow-hidden">

    <!-- ===== HEADER ===== -->
    <header
        class="bg-white border-b border-slate-200 shadow-sm px-5 py-2.5 flex items-center justify-between flex-shrink-0 z-30">
        <div class="flex items-center gap-3">
            <button id="btnBackDash" onclick="goToDashboard()" title="ダッシュボードに戻る"
                class="w-8 h-8 bg-slate-100 hover:bg-indigo-50 text-slate-500 hover:text-indigo-600 rounded-lg flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
            </button>
            <div
                class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center shadow">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <h1 class="text-base font-bold tracking-tight">領収書・請求書 データ化ツール</h1>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <label class="text-sm font-medium text-slate-500 whitespace-nowrap">担当者：</label>
                <select id="selStaff"
                    class="bg-slate-50 border border-slate-300 text-sm font-medium rounded-lg px-3 py-1.5 min-w-[140px] cursor-pointer hover:border-indigo-400 transition-colors">
                    <option value="">(未選択)</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-sm font-medium text-slate-500 whitespace-nowrap">関与先：</label>
                <select id="selClient"
                    class="bg-slate-50 border border-slate-300 text-sm font-medium rounded-lg px-3 py-1.5 min-w-[160px] cursor-pointer hover:border-indigo-400 transition-colors"></select>
            </div>
            <button onclick="addClient()"
                class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 text-sm font-medium rounded-lg px-3 py-1.5 transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>新規追加
            </button>
            <button onclick="openSheet()" title="スプレッドシートを開く"
                class="bg-emerald-50 text-emerald-600 hover:bg-emerald-100 text-sm font-medium rounded-lg px-2.5 py-1.5 transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </button>
            <button onclick="goToSearch()" title="データ検索を開く"
                class="bg-slate-100 text-slate-600 hover:bg-slate-200 text-sm font-medium rounded-lg px-2.5 py-1.5 transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                検索
            </button>
        </div>
        <div class="text-sm text-slate-500 flex items-center gap-1.5"><span
                class="w-2 h-2 rounded-full bg-emerald-400"></span><span id="elStats">0 / 0</span></div>
    </header>

    <!-- ===== MAIN ===== -->
    <main class="flex-1 flex overflow-hidden">

        <!-- LEFT SIDEBAR -->
        <aside class="w-72 bg-white border-r border-slate-200 flex flex-col flex-shrink-0">
            <!-- Drop zone -->
            <div class="p-3 border-b border-slate-100">
                <div id="dropZone"
                    class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center cursor-pointer transition-all hover:border-indigo-400 hover:bg-indigo-50/30"
                    onclick="document.getElementById('fileIn').click()">
                    <svg class="w-8 h-8 mx-auto text-slate-400 mb-1" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    <p class="text-xs font-medium text-slate-600">ドラッグ＆ドロップ</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">画像 / PDF 対応</p>
                </div>
                <input type="file" id="fileIn" class="hidden" multiple
                    accept="image/jpeg,image/png,image/gif,image/webp,image/bmp,application/pdf">
            </div>
            <!-- Tabs -->
            <div class="flex border-b border-slate-200">
                <button onclick="switchTab('queue')" id="tabQueue"
                    class="flex-1 py-2 text-xs text-center cursor-pointer tab-active">未処理 <span id="badgeQueue"
                        class="bg-indigo-100 text-indigo-600 rounded-full px-1.5 py-0.5 ml-0.5 text-[10px]">0</span></button>
                <button onclick="switchTab('saved')" id="tabSaved"
                    class="flex-1 py-2 text-xs text-center cursor-pointer tab-inactive">保存済み <span id="badgeSaved"
                        class="bg-slate-100 text-slate-500 rounded-full px-1.5 py-0.5 ml-0.5 text-[10px]">0</span></button>
            </div>
            <!-- Queue list -->
            <div id="panelQueue" class="flex-1 overflow-y-auto scroll-thin">
                <div id="emptyQueue" class="px-3 py-8 text-center">
                    <p class="text-xs text-slate-400">ファイルがありません</p>
                </div>
            </div>
            <!-- Saved list -->
            <div id="panelSaved" class="flex-1 overflow-y-auto scroll-thin hidden"></div>
        </aside>

        <!-- CENTER PANE -->
        <section class="flex-1 flex flex-col bg-slate-100/50 min-w-0">
            <div class="flex-1 relative overflow-hidden p-4 flex flex-col" id="previewArea">
                <div id="emptyPreview"
                    class="absolute inset-0 flex flex-col items-center justify-center text-slate-400">
                    <svg class="w-16 h-16 mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <p class="text-sm">ファイルを選択するとプレビュー表示</p>
                </div>
                <div id="wrapImg" class="hidden flex-1 w-full bg-slate-200/50 rounded-xl overflow-hidden relative"
                    style="min-height:0;">
                    <img id="prevImg" style="display:block; width:100%;" alt="">
                </div>
                <div id="wrapPdf" class="hidden absolute inset-4 overflow-auto">
                    <div id="pdfPagesContainer" class="pdf-page-container"></div>
                </div>
            </div>
            <div id="toolbar" class="hidden px-4 py-2 bg-white border-t border-slate-200 flex items-center gap-3">
                <button onclick="reanalyze()"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-lg px-3 py-1.5 transition-colors flex items-center gap-1.5 shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>全フィールド再解析</button>
                <button onclick="resetCrop()"
                    class="bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors">リセット</button>
                <span class="text-[10px] text-orange-500 font-medium ml-1">ドラッグで範囲選択→右パネルのAIボタンで各項目取得</span>
            </div>
        </section>

        <!-- RIGHT PANE -->
        <aside class="w-80 bg-white border-l border-slate-200 flex flex-col flex-shrink-0">
            <div class="px-4 py-2.5 border-b border-slate-100 flex items-center justify-between">
                <h2 class="text-xs font-semibold text-slate-700 uppercase tracking-wider">解析結果</h2>
                <span id="elFileName" class="text-[10px] text-slate-400 max-w-[130px] truncate"></span>
            </div>
            <div class="flex-1 px-4 py-3 space-y-3 overflow-y-auto">
                <div><label
                        class="block text-[10px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">日付</label>
                    <div class="flex gap-1.5">
                        <input type="date" id="inDate"
                            class="flex-1 min-w-0 border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white transition-all">
                        <button onclick="pickField('inDate','date')" title="画像/選択範囲から日付をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-xs font-medium rounded-lg px-2.5 py-2 transition-colors flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>AI
                        </button>
                    </div>
                </div>
                <div><label
                        class="block text-[10px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">支払先</label>
                    <div class="flex gap-1.5">
                        <input type="text" id="inPayee" placeholder="例：〇〇商店"
                            class="flex-1 min-w-0 border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white transition-all">
                        <button onclick="pickField('inPayee','payee')" title="画像から支払先をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-xs font-medium rounded-lg px-2.5 py-2 transition-colors flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>AI
                        </button>
                    </div>
                </div>
                <div><label
                        class="block text-[10px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">金額（税込）</label>
                    <div class="flex gap-1.5 mb-1.5">
                        <div class="relative flex-1 min-w-0">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">¥</span>
                            <input type="number" id="inAmount" placeholder="0" min="0"
                                class="w-full border border-slate-300 rounded-lg pl-7 pr-3 py-2 text-sm bg-white transition-all">
                        </div>
                        <button onclick="pickField('inAmount','amount')" title="画像から金額をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-xs font-medium rounded-lg px-2.5 py-2 transition-colors flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>AI
                        </button>
                    </div>
                    <div class="flex gap-1.5">
                        <div class="relative flex-1 min-w-0">
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px]">10%
                                ¥</span>
                            <input type="number" id="inAmount10" placeholder="0" min="0"
                                class="w-full border border-slate-300 rounded-lg pl-10 pr-2 py-1.5 text-xs bg-slate-50 transition-all">
                        </div>
                        <button onclick="pickField('inAmount10','amount10')" title="画像から10%対象金額をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-[10px] font-medium rounded-lg px-2 py-1.5 transition-colors flex items-center gap-1">
                            AI
                        </button>
                        <div class="relative flex-1 min-w-0">
                            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px]">8%
                                ¥</span>
                            <input type="number" id="inAmount8" placeholder="0" min="0"
                                class="w-full border border-slate-300 rounded-lg pl-9 pr-2 py-1.5 text-xs bg-slate-50 transition-all">
                        </div>
                        <button onclick="pickField('inAmount8','amount8')" title="画像から8%対象金額をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-[10px] font-medium rounded-lg px-2 py-1.5 transition-colors flex items-center gap-1">
                            AI
                        </button>
                    </div>
                </div>
                <div><label
                        class="block text-[10px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">勘定科目</label>
                    <select id="inAccount"
                        class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white transition-all cursor-pointer">
                        <option value="">-- 選択 --</option>
                        <option>旅費交通費</option>
                        <option>消耗品費</option>
                        <option>接待交際費</option>
                        <option>通信費</option>
                        <option>水道光熱費</option>
                        <option>地代家賃</option>
                        <option>事務用品費</option>
                        <option>広告宣伝費</option>
                        <option>修繕費</option>
                        <option>外注費</option>
                        <option>福利厚生費</option>
                        <option>租税公課</option>
                        <option>保険料</option>
                        <option>支払手数料</option>
                        <option>新聞図書費</option>
                        <option>会議費</option>
                        <option>車両費</option>
                        <option>荷造運賃</option>
                        <option>雑費</option>
                    </select>
                </div>
                <div><label class="block text-[10px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">インボイス番号
                        <span class="text-slate-400 normal-case">(任意)</span></label>
                    <div class="flex gap-1.5">
                        <input type="text" id="inInvoiceNo" placeholder="例：T1234567890123"
                            class="flex-1 min-w-0 border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white transition-all font-mono">
                        <button onclick="pickField('inInvoiceNo','invoiceNo')" title="画像からインボイス番号をAI読み取り"
                            class="flex-shrink-0 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-xs font-medium rounded-lg px-2.5 py-2 transition-colors flex items-center gap-1 border border-indigo-100">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002 2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                            </svg>AI
                        </button>
                        <button onclick="checkInvoice()" title="国税庁公表サイトで登録を照合"
                            class="flex-shrink-0 bg-white hover:bg-green-50 text-green-600 border border-green-200 text-xs font-medium rounded-lg px-2.5 py-2 transition-colors flex items-center gap-1 shadow-sm">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                                </path>
                            </svg>確認
                        </button>
                    </div>
                    <div id="invoiceCheckResult"
                        class="mt-1 hidden text-[10px] items-center gap-1 font-medium bg-slate-50 p-1.5 rounded-md border border-slate-100">
                        <span id="invoiceBadge"></span>
                        <span id="invoiceName" class="truncate flex-1"></span>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-[10px] font-semibold text-slate-500 uppercase tracking-wider">摘要メモ
                            <span class="text-slate-400 normal-case">(任意)</span></label>
                        <button onclick="pickField('inMemo','memo')" title="画像から摘要をAI読み取り"
                            class="bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-[10px] font-medium rounded-md px-2 py-1 transition-colors flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>AI入力
                        </button>
                    </div>
                    <textarea id="inMemo" rows="2" placeholder="特記事項"
                        class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white transition-all resize-none"></textarea>
                </div>
            </div>
            <div class="px-4 py-3 border-t border-slate-100 space-y-2.5 flex-shrink-0">
                <button id="btnSave" onclick="saveAndNext()" disabled
                    class="w-full bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 disabled:from-slate-300 disabled:to-slate-300 disabled:cursor-not-allowed text-white font-semibold rounded-xl px-4 py-2.5 transition-all shadow-md flex items-center justify-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>保存して次へ<kbd
                        class="bg-indigo-500/30 text-[10px] px-1.5 py-0.5 rounded ml-1">Enter</kbd></button>
                <div class="flex items-center gap-2">
                    <div class="flex-1 h-px bg-slate-200"></div><span class="text-[10px] text-slate-400">出力</span>
                    <div class="flex-1 h-px bg-slate-200"></div>
                </div>
                <button onclick="downloadZip()"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl px-4 py-2.5 transition-all shadow-md flex items-center justify-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>ZIPダウンロード</button>
                <div class="text-center text-[10px] text-slate-400">保存済み：<span id="elSaved">0</span> 件</div>
            </div>
        </aside>
    </main>

    <!-- TOAST -->
    <div id="toastBox" class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none"></div>
    <!-- LOADING -->
    <div id="loadOv" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-2xl p-6 shadow-2xl flex flex-col items-center gap-3 max-w-xs">
            <div class="w-12 h-12 border-4 border-indigo-100 border-t-indigo-600 rounded-full animate-spin"></div>
            <p id="loadTxt" class="text-sm font-semibold text-slate-700">解析中...</p>
            <p class="text-[10px] text-slate-400">Gemini AIが読み取り中</p>
        </div>
    </div>

    <!-- ===== JAVASCRIPT ===== -->
    <script>
        // ★ PDF.js Worker: GASのiframe内ではCDN Workerが読み込めないため無効化（メインスレッドで処理）
        pdfjsLib.GlobalWorkerOptions.workerSrc = '';

        // ========== STATE ==========
        var S = {
            clients: [], curClient: '', files: [], curIdx: -1, cropper: null, acnt: 0, busy: false, tab: 'queue',
            savedItems: [], staff: {}, curStaff: ''
        };

        // ========== IndexedDB (ローカルキャッシュ用、ファイルデータ保持) ==========
        var DB_NAME = 'receiptToolDB', DB_VER = 1, STORE = 'items';
        function openDB() { return new Promise(function (ok, ng) { var r = indexedDB.open(DB_NAME, DB_VER); r.onupgradeneeded = function (e) { var db = e.target.result; if (!db.objectStoreNames.contains(STORE)) { var s = db.createObjectStore(STORE, { keyPath: 'id' }); s.createIndex('client', 'clientName'); s.createIndex('ym', 'yearMonth') } }; r.onsuccess = function (e) { ok(e.target.result) }; r.onerror = function (e) { ng(e.target.error) } }) }
        function dbPut(item) { return openDB().then(function (db) { return new Promise(function (ok, ng) { var tx = db.transaction(STORE, 'readwrite'); var s = tx.objectStore(STORE); var r = s.put(item); r.onsuccess = function () { ok(r.result) }; r.onerror = function () { ng(r.error) } }) }) }
        function dbAll() { return openDB().then(function (db) { return new Promise(function (ok, ng) { var tx = db.transaction(STORE, 'readonly'); var r = tx.objectStore(STORE).getAll(); r.onsuccess = function () { ok(r.result) }; r.onerror = function () { ng(r.error) } }) }) }
        function dbDel(id) { return openDB().then(function (db) { return new Promise(function (ok, ng) { var tx = db.transaction(STORE, 'readwrite'); tx.objectStore(STORE).delete(id).onsuccess = function () { ok() } }) }) }

        // ========== INIT ==========
        document.addEventListener('DOMContentLoaded', function () {
            loadClients(); setupDnD(); setupKeys();
            document.getElementById('fileIn').addEventListener('change', function (e) { if (e.target.files.length > 0) { handleFiles(e.target.files); e.target.value = '' } });
            loadSavedItems(); updateUI();
            // ダッシュボード戻りリンクのURLを設定
            try {
                google.script.run.withSuccessHandler(function (url) {
                    window._appUrl = url;
                }).getAppUrl();
            } catch (e) { /* ローカル実行時は無視 */ }
        });

        // ========== CLIENTS ==========
        function loadClients() {
            var s = localStorage.getItem('rt_clients');
            S.clients = s ? JSON.parse(s) : ['A社', 'B社', 'C社'];
            S.curClient = localStorage.getItem('rt_cur') || S.clients[0] || '';
            S.curStaff = localStorage.getItem('rt_cur_staff') || '';

            // URLパラメータから関与先指定があれば優先
            try {
                var params = new URLSearchParams(window.location.search);
                var clientParam = params.get('client');
                if (clientParam && S.clients.includes(clientParam)) {
                    S.curClient = clientParam;
                    saveClientsLS();
                }
            } catch (e) { /* ignore */ }

            renderStaffList();
            renderClients();

            // サーバーからデータを同期
            try {
                google.script.run.withSuccessHandler(function (serverClients) {
                    if (serverClients && serverClients.length > 0) {
                        S.clients = serverClients;
                        if (!S.curClient || !S.clients.includes(S.curClient)) S.curClient = S.clients[0] || '';
                        saveClientsLS();
                        renderClients();
                    }
                }).getClientsList();

                google.script.run.withSuccessHandler(function (serverStaff) {
                    S.staff = serverStaff || {};
                    renderStaffList();
                    // 担当者が選択されている場合、関与先リストを再描画
                    if (S.curStaff) renderClients();
                }).getStaffList();
            } catch (e) {
                console.error("Server data sync error:", e);
                // サーバー接続エラー時でもローカルキャッシュで一覧更新できるようにする
                renderStaffList();
                renderClients();
            }
        }

        function saveClientsLS() {
            localStorage.setItem('rt_clients', JSON.stringify(S.clients));
            localStorage.setItem('rt_cur', S.curClient);
            localStorage.setItem('rt_cur_staff', S.curStaff);
        }

        function renderStaffList() {
            var el = document.getElementById('selStaff');
            var names = Object.keys(S.staff).sort();
            var html = '<option value="">(全員表示)</option>';
            names.forEach(function (n) {
                html += '<option value="' + esc(n) + '" ' + (n === S.curStaff ? 'selected' : '') + '>' + esc(n) + '</option>';
            });
            el.innerHTML = html;
            el.onchange = function () {
                S.curStaff = el.value;
                saveClientsLS();
                renderClients();
                updateSavedCount();
                renderSaved();
            };
        }

        function renderClients() {
            var el = document.getElementById('selClient');
            el.innerHTML = '';

            // 担当者が選択されている場合、その担当者の関与先のみを抽出
            var visibleClients = S.clients;
            if (S.curStaff && S.staff[S.curStaff]) {
                var linked = S.staff[S.curStaff];
                visibleClients = S.clients.filter(function (c) { return linked.indexOf(c) !== -1; });
            }

            if (visibleClients.length === 0) {
                var o = document.createElement('option');
                o.value = "";
                o.textContent = "(担当なし)";
                el.appendChild(o);
                S.curClient = "";
            } else {
                visibleClients.forEach(function (n) {
                    var o = document.createElement('option');
                    o.value = n;
                    o.textContent = n;
                    if (n === S.curClient) o.selected = true;
                    el.appendChild(o);
                });
                // 現在の選択がリストにない場合は先頭を選択
                if (!S.curClient || visibleClients.indexOf(S.curClient) === -1) {
                    S.curClient = visibleClients[0];
                    el.selectedIndex = 0;
                }
            }

            el.onchange = function () {
                S.curClient = el.value;
                saveClientsLS();
                updateSavedCount();
                renderSaved();
            };
        }
        function addClient() {
            var n = prompt('新しい関与先名：');
            if (!n || !n.trim()) return;
            n = n.trim();
            if (S.clients.includes(n)) { toast('既に存在します', 'warning'); return }
            S.clients.push(n); S.curClient = n; saveClientsLS(); renderClients();
            // サーバーにも同期
            try { google.script.run.addClientServer(n); } catch (e) { /* ignore */ }
            toast('「' + n + '」追加', 'success');
        }

        // ========== DASHBOARD NAVIGATION ==========
        function goToDashboard() {
            if (window._appUrl) {
                window.top.location.href = window._appUrl + '?page=dashboard';
            } else {
                try {
                    google.script.run.withSuccessHandler(function (url) {
                        window.top.location.href = url + '?page=dashboard';
                    }).getAppUrl();
                } catch (e) { toast('ダッシュボードURLが取得できません', 'warning'); }
            }
        }
        function goToSearch() {
            if (window._appUrl) {
                window.top.location.href = window._appUrl + '?page=search';
            } else {
                try {
                    google.script.run.withSuccessHandler(function (url) {
                        window.top.location.href = url + '?page=search';
                    }).getAppUrl();
                } catch (e) { toast('検索ページURLが取得できません', 'warning'); }
            }
        }

        // ========== OPEN SHEET ==========
        function openSheet() {
            google.script.run.withSuccessHandler(function (url) {
                if (url) window.open(url, '_blank');
                else toast('スプレッドシート未作成（データ保存後に作成されます）', 'info');
            }).withFailureHandler(function () {
                toast('スプレッドシートURL取得エラー', 'error');
            }).getSheetUrl();
        }

        // ========== DRAG & DROP ==========
        function setupDnD() {
            var dz = document.getElementById('dropZone');['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function (ev) { dz.addEventListener(ev, pd, false); document.body.addEventListener(ev, pd, false) });
            ['dragenter', 'dragover'].forEach(function (ev) { dz.addEventListener(ev, function () { dz.classList.add('drop-active') }, false) });
            ['dragleave', 'drop'].forEach(function (ev) { dz.addEventListener(ev, function () { dz.classList.remove('drop-active') }, false) });
            dz.addEventListener('drop', function (e) { if (e.dataTransfer.files.length > 0) handleFiles(e.dataTransfer.files) }, false)
        }
        function pd(e) { e.preventDefault(); e.stopPropagation() }

        // ========== KEYBOARD ==========
        function setupKeys() { document.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey && e.target.tagName !== 'TEXTAREA') { var ids = ['inDate', 'inPayee', 'inAmount', 'inAccount', 'inMemo']; if (ids.includes(e.target.id)) { e.preventDefault(); saveAndNext() } } }) }

        // ========== FILE HANDLING ==========
        function handleFiles(fl) {
            var vt = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/bmp', 'application/pdf']; var ps = [], c = 0;
            for (var i = 0; i < fl.length; i++) { var f = fl[i]; if (!vt.includes(f.type)) { toast('非対応: ' + f.name, 'warning'); continue } if (f.size > 10 * 1024 * 1024) { toast('大きすぎ: ' + f.name, 'warning'); continue } ps.push(readF(f)); c++ }
            if (c === 0) return;
            Promise.all(ps).then(function (rs) { rs.forEach(function (r) { S.files.push(r) }); renderQueue(); updateStats(); if (S.curIdx === -1) selectFile(0); toast(c + '件追加', 'success') })
        }
        function readF(file) {
            return new Promise(function (ok, ng) {
                var r = new FileReader(); r.onload = function () {
                    var du = r.result;
                    ok({
                        id: Date.now() + '_' + Math.random().toString(36).substr(2, 6),
                        name: file.name,
                        ext: file.name.split('.').pop().toLowerCase(),
                        mime: file.type,
                        dataUrl: du,
                        b64: du.split(',')[1],
                        status: 'pending'
                    });
                };
                r.onerror = function () { ng() };
                r.readAsDataURL(file);
            });
        }

        // ========== SIDEBAR TABS ==========
        function switchTab(t) {
            S.tab = t; var tq = document.getElementById('tabQueue'), ts = document.getElementById('tabSaved'), pq = document.getElementById('panelQueue'), ps = document.getElementById('panelSaved');
            if (t === 'queue') { tq.className = 'flex-1 py-2 text-xs text-center cursor-pointer tab-active'; ts.className = 'flex-1 py-2 text-xs text-center cursor-pointer tab-inactive'; pq.classList.remove('hidden'); ps.classList.add('hidden') }
            else { ts.className = 'flex-1 py-2 text-xs text-center cursor-pointer tab-active'; tq.className = 'flex-1 py-2 text-xs text-center cursor-pointer tab-inactive'; ps.classList.remove('hidden'); pq.classList.add('hidden'); renderSaved() }
        }

        // ========== QUEUE LIST ==========
        function selectFile(i) {
            if (i < 0 || i >= S.files.length) return;
            S.curIdx = i;
            var f = S.files[i];
            renderQueue();
            showPreview(f);
            document.getElementById('elFileName').textContent = f.name;
            document.getElementById('btnSave').disabled = false;
            if (f.status === 'pending') {
                clearForm();
                analyzeFile(f);
            } else if (f.status === 'done' && f.extractedData) {
                fillForm(f.extractedData);
            } else if (f.status === 'processing') {
                // 解析中は何もしない（完了時にfillFormが呼ばれる）
            } else {
                clearForm();
            }
        }
        function renderQueue() {
            var c = document.getElementById('panelQueue'), eq = document.getElementById('emptyQueue');
            c.querySelectorAll('.fi').forEach(function (el) { el.remove() });
            if (S.files.length === 0) { eq.style.display = ''; document.getElementById('badgeQueue').textContent = '0'; return }
            eq.style.display = 'none';
            S.files.forEach(function (f, i) {
                var d = document.createElement('div'); d.className = 'fi px-3 py-2 cursor-pointer flex items-center gap-2.5 border-b border-slate-50' + (i === S.curIdx ? ' active' : ''); d.onclick = function () { selectFile(i) };
                var sc = { pending: 'bg-slate-300', processing: 'bg-amber-400 animate-pulse', done: 'bg-emerald-500', error: 'bg-rose-500' };
                var th = f.mime.startsWith('image/') ? '<img src="' + f.dataUrl + '" class="w-8 h-8 rounded object-cover flex-shrink-0 bg-slate-100">' : '<div class="w-8 h-8 rounded bg-rose-50 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg></div>';
                var sl = { pending: '未処理', processing: '解析中...', done: '処理済み', error: 'エラー' };
                var delBtn = '<button onclick="event.stopPropagation(); removeFile(' + i + ')" title="削除" class="p-1.5 text-slate-300 hover:text-rose-500 rounded hover:bg-rose-50 transition-colors flex-shrink-0"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>';
                d.innerHTML = '<div class="w-2 h-2 rounded-full ' + sc[f.status] + ' flex-shrink-0"></div>' + th + '<div class="min-w-0 flex-1"><p class="text-[11px] font-medium text-slate-700 truncate">' + esc(f.name) + '</p><p class="text-[10px] text-slate-400">' + sl[f.status] + '</p></div>' + delBtn;
                c.appendChild(d)
            });
            document.getElementById('badgeQueue').textContent = S.files.length
        }
        function removeFile(i) {
            var f = S.files[i];
            if (!confirm('「' + f.name + '」を削除しますか？')) return;

            S.files.splice(i, 1);

            if (S.curIdx === i) {
                S.curIdx = -1;
                document.getElementById('btnSave').disabled = true; destroyCropper();
                document.getElementById('wrapImg').classList.add('hidden'); document.getElementById('wrapPdf').classList.add('hidden');
                document.getElementById('toolbar').classList.add('hidden'); document.getElementById('emptyPreview').style.display = '';
                document.getElementById('elFileName').textContent = ''; clearForm();
                document.getElementById('invoiceCheckResult').classList.add('hidden');

                if (S.files.length > 0) {
                    var next = findNext(i);
                    if (next !== -1) selectFile(next);
                    else selectFile(0);
                }
            } else if (S.curIdx > i) {
                S.curIdx--;
            }
            renderQueue(); updateStats(); toast('削除しました', 'success');
        }

        // ========== SAVED LIST (monthly grouped) ==========
        function loadSavedItems() {
            // スプレッドシートからデータ取得
            try {
                google.script.run.withSuccessHandler(function (items) {
                    S.savedItems = items || [];
                    // IndexedDBのファイルデータとマージ
                    dbAll().then(function (localItems) {
                        var localMap = {};
                        localItems.forEach(function (li) { localMap[li.id] = li });
                        S.savedItems.forEach(function (si) {
                            if (localMap[si.id]) {
                                si.fileBase64 = localMap[si.id].fileBase64;
                                si.mimeType = localMap[si.id].mimeType;
                            }
                        });
                        updateSavedCount(); renderSaved();
                    }).catch(function () { updateSavedCount(); renderSaved() });
                }).withFailureHandler(function () {
                    // スプレッドシートからの取得失敗時はIndexedDBから読み込み
                    dbAll().then(function (items) { S.savedItems = items; updateSavedCount(); renderSaved() }).catch(function () { S.savedItems = []; updateSavedCount() });
                }).getSheetData(S.curClient);
            } catch (e) {
                console.warn('Server sync skipped:', e);
                dbAll().then(function (items) { S.savedItems = items; updateSavedCount(); renderSaved() }).catch(function () { S.savedItems = []; updateSavedCount() });
            }
        }
        function renderSaved() {
            var c = document.getElementById('panelSaved'); c.innerHTML = '';
            var items = S.savedItems.filter(function (it) { return it.clientName === S.curClient });
            document.getElementById('badgeSaved').textContent = items.length;
            if (items.length === 0) { c.innerHTML = '<div class="px-3 py-8 text-center"><p class="text-xs text-slate-400">保存済みデータなし</p></div>'; return }
            var grouped = {}; items.forEach(function (it) { var ym = it.date ? it.date.substring(0, 7) : '不明'; if (!grouped[ym]) grouped[ym] = []; grouped[ym].push(it) });
            var months = Object.keys(grouped).sort().reverse();
            months.forEach(function (m) {
                var label = m === '不明' ? '日付なし' : m.replace('-', '年') + '月';
                var total = grouped[m].reduce(function (sum, it) { return sum + (Number(it.amount) || 0) }, 0);
                var hdr = document.createElement('div'); hdr.className = 'month-header';
                hdr.innerHTML = '<span>📅 ' + label + ' (' + grouped[m].length + '件)</span><span class="month-total">¥' + total.toLocaleString() + '</span>';
                c.appendChild(hdr);
                grouped[m].forEach(function (it) {
                    var d = document.createElement('div'); d.className = 'fi px-3 py-2 cursor-pointer flex items-center gap-2.5 border-b border-slate-50';
                    d.onclick = function () { viewSavedItem(it) };
                    d.innerHTML = '<div class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></div><div class="min-w-0 flex-1"><p class="text-[11px] font-medium text-slate-700 truncate">' + esc(it.payee) + '</p><p class="text-[10px] text-slate-400">' + esc(it.date || '') + ' ¥' + Number(it.amount).toLocaleString() + '</p></div><button onclick="event.stopPropagation();deleteSaved(\'' + esc(String(it.id)) + '\')" class="text-slate-300 hover:text-rose-500 transition-colors flex-shrink-0"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>';
                    c.appendChild(d)
                })
            })
        }
        function viewSavedItem(it) {
            document.getElementById('elFileName').textContent = it.fileName || ''; document.getElementById('inDate').value = toDateInput(it.date); document.getElementById('inPayee').value = it.payee || ''; document.getElementById('inAmount').value = it.amount || ''; document.getElementById('inAmount10').value = it.amount10 || ''; document.getElementById('inAmount8').value = it.amount8 || ''; setAccount(it.account); document.getElementById('inInvoiceNo').value = it.invoiceNo || ''; document.getElementById('inMemo').value = it.memo || '';
            document.getElementById('invoiceCheckResult').classList.add('hidden'); // 結果表示をリセット
            if (it.fileBase64 && it.mimeType) { showPreviewFromData(it.fileBase64, it.mimeType) }
        }
        function deleteSaved(id) {
            if (!confirm('この保存データを削除しますか？')) return;
            // スプレッドシートからも削除
            google.script.run.withSuccessHandler(function () {
                // IndexedDBからも削除
                dbDel(id).catch(function () { });
                S.savedItems = S.savedItems.filter(function (x) { return String(x.id) !== String(id) });
                renderSaved(); updateSavedCount(); toast('削除しました', 'success');
            }).withFailureHandler(function (e) {
                toast('削除エラー: ' + e.message, 'error');
            }).deleteFromSheet(id);
        }

        // ========== PREVIEW ==========
        function showPreview(file) {
            destroyCropper(); document.getElementById('emptyPreview').style.display = 'none';
            var wi = document.getElementById('wrapImg'), wp = document.getElementById('wrapPdf'), tb = document.getElementById('toolbar');
            if (file.mime === 'application/pdf') {
                wi.classList.add('hidden'); wi.classList.remove('flex');
                wp.classList.remove('hidden'); tb.classList.add('hidden'); renderPdf(file.b64);
            }
            else {
                wp.classList.add('hidden');
                wi.classList.remove('hidden'); wi.classList.add('flex');
                tb.classList.remove('hidden'); // ツールバー表示
                var img = document.getElementById('prevImg');
                img.onload = function () {
                    // 画像のレンダリング完了を待ってからCropperを初期化
                    setTimeout(initCropper, 50);
                };
                img.src = file.dataUrl;
            }
        }
        function showPreviewFromData(b64, mime) {
